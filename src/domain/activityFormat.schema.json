{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:travel-organizer:activities:1",
  "title": "Travel Organizer activities, version 1",
  "description": "Activities to add to an existing trip in the Travel Organizer app. Leave out anything you do not know: never invent dates, times, prices, addresses, coordinates or booking details. Use status \"idea\" for suggestions.",
  "type": "object",
  "required": ["format", "version", "activities"],
  "additionalProperties": false,
  "properties": {
    "format": { "const": "travel-organizer-activities" },
    "version": { "const": 1 },
    "activities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": { "$ref": "#/$defs/activity" }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "description": "A calendar date, YYYY-MM-DD, e.g. 2026-11-21."
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "description": "Local wall-clock time, 24-hour HH:mm, e.g. 09:30. No seconds, no offset."
    },
    "timeZone": {
      "type": "string",
      "pattern": "^(UTC|[A-Za-z]+(/[A-Za-z0-9_+-]+)+)$",
      "description": "An IANA time zone, e.g. Europe/Helsinki. Leave it out to use the trip's own zone."
    },
    "activity": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "kind": {
          "enum": ["activity", "food", "stay", "transport", "other"],
          "default": "activity",
          "description": "What sort of thing it is."
        },
        "type": {
          "type": ["string", "null"],
          "description": "Optional finer type. Must belong to the kind: activity: museum, gallery, tour, attraction, event, theatre, outdoor, spa. food: restaurant, cafe, bar, bakery, market. stay: hotel, apartment, hostel, guesthouse, camping. transport: flight, train, bus, ferry, car, taxi, transfer, walk. other: luggage, insurance, parking, shopping, viewpoint.",
          "enum": [
            "museum", "gallery", "tour", "attraction", "event", "theatre", "outdoor", "spa",
            "restaurant", "cafe", "bar", "bakery", "market",
            "hotel", "apartment", "hostel", "guesthouse", "camping",
            "flight", "train", "bus", "ferry", "car", "taxi", "transfer", "walk",
            "luggage", "insurance", "parking", "shopping", "viewpoint",
            null
          ]
        },
        "status": {
          "enum": ["idea", "planned"],
          "default": "idea",
          "description": "idea: a suggestion, saved to Places. planned: the traveller has decided to do it; it goes on the Timeline. Not a booking."
        },
        "priority": {
          "enum": ["must", "want", "maybe", null],
          "description": "How much it is wanted. Ideas only."
        },
        "date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
        "startTime": {
          "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }],
          "description": "Needs date."
        },
        "endDate": {
          "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }],
          "description": "Needs date; only when it ends on a later day."
        },
        "endTime": {
          "anyOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }],
          "description": "Needs date."
        },
        "timeZone": { "anyOf": [{ "$ref": "#/$defs/timeZone" }, { "type": "null" }] },
        "endTimeZone": {
          "anyOf": [{ "$ref": "#/$defs/timeZone" }, { "type": "null" }],
          "description": "Only when the end is in another zone, e.g. a flight's arrival."
        },
        "location": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "name": { "type": ["string", "null"], "maxLength": 120 },
            "address": { "type": ["string", "null"], "maxLength": 240 },
            "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
            "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 }
          },
          "dependentRequired": { "latitude": ["longitude"], "longitude": ["latitude"] }
        },
        "notes": { "type": ["string", "null"], "maxLength": 4000 },
        "description": {
          "type": ["string", "null"],
          "maxLength": 4000,
          "description": "Stored with the notes, before them."
        },
        "price": {
          "type": ["object", "null"],
          "description": "The expected total for the activity. Never a payment.",
          "required": ["amount", "currency"],
          "additionalProperties": false,
          "properties": {
            "amount": {
              "description": "Total, at most two decimals, e.g. \"290.00\" or 290.",
              "oneOf": [
                { "type": "string", "pattern": "^\\d+(\\.\\d{1,2})?$" },
                { "type": "number", "minimum": 0, "multipleOf": 0.01 }
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$",
              "description": "ISO 4217 code, e.g. EUR."
            }
          }
        },
        "links": {
          "type": ["array", "null"],
          "maxItems": 10,
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "label": { "type": ["string", "null"], "maxLength": 120 },
              "url": { "type": "string", "maxLength": 2048, "pattern": "^https?://\\S+$" }
            }
          }
        },
        "transport": {
          "type": ["object", "null"],
          "description": "Only for kind transport.",
          "additionalProperties": false,
          "properties": {
            "from": { "type": ["string", "null"], "maxLength": 80 },
            "to": { "type": ["string", "null"], "maxLength": 80 },
            "carrier": { "type": ["string", "null"], "maxLength": 60 },
            "number": { "type": ["string", "null"], "maxLength": 24 }
          }
        }
      }
    }
  }
}
